# Dán các biến này vào Vercel → Project → Settings → Environment Variables (Production), rồi Redeploy.
# Service account của dự án Firebase "quangcao-9a705": Firebase console → Project settings → Service accounts → Generate new private key,
# dán NGUYÊN nội dung file JSON (hoặc bản base64). Không đưa file này lên GitHub.
FIREBASE_SERVICE_ACCOUNT=
# Ai được xem / ai là quản trị (email Microsoft 365 của trường, phân cách bằng dấu phẩy)
FBADS_VIEWERS=
FBADS_ADMINS=
# (tuỳ chọn) mở cho cả một tên miền, ví dụ hoangmaistarschool.edu.vn – mặc định để trống
FBADS_VIEWER_DOMAINS=
# Bí mật cho Vercel Cron (Vercel tự gửi Bearer CRON_SECRET) – chuỗi ngẫu nhiên dài
CRON_SECRET=
# Bí mật để tác vụ Claude đẩy số liệu lên /api/ingest – chuỗi ngẫu nhiên dài, đặt giống trong máy quản trị
INGEST_SECRET=
# (tuỳ chọn) token System User của Meta, quyền ads_read – có thì máy chủ tự lấy số liệu mỗi sáng
META_ACCESS_TOKEN=
# (tuỳ chọn) danh sách tài khoản quảng cáo, mặc định 4 tài khoản của trường
META_AD_ACCOUNTS=
# (tuỳ chọn, ít khi cần) phiên bản Meta Graph API, mặc định v25.0
# META_API_VERSION=v25.0
# (tuỳ chọn, ít khi cần) tên collection Firestore, mặc định fbads
# FBADS_COLLECTION=fbads
# (cách khác thay cho FIREBASE_SERVICE_ACCOUNT) ba biến lấy từ file JSON của service account
# FIREBASE_PROJECT_ID=quangcao-9a705
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
